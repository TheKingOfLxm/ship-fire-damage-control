# AI服务配置示例（仅支持国内AI服务）
# 复制此文件为 .env 或 .env.local 并填入你的API密钥

# AI提供商选择: glm（智谱AI，推荐）| qwen（通义千问）
# 默认使用GLM（智谱AI）
VITE_AI_PROVIDER=glm

# AI API密钥（必填，如果不填将使用Mock数据）
VITE_AI_API_KEY=your_api_key_here

# AI API基础URL（可选，使用默认值时可留空）
# GLM: https://open.bigmodel.cn/api/paas/v4
# Qwen: https://dashscope.aliyuncs.com/api/v1
VITE_AI_BASE_URL=

# 使用说明：
# 1. GLM（智谱AI，推荐）: 从 https://open.bigmodel.cn/ 获取API密钥
# 2. 通义千问: 从 https://dashscope.console.aliyun.com/ 获取API密钥
#
# 配置示例：
# VITE_AI_PROVIDER=glm
# VITE_AI_API_KEY=your_glm_api_key_here

