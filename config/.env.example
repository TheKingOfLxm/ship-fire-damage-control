# 前端配置（复制为 config/.env.development 后按需修改）
# ⚠ vite.config.js 里 envDir 指向 ./config，所以这份文件必须放在 config/ 目录下，
#   根目录的 .env / env.development 不会被读取。

# 后端API配置
VITE_API_BASE_URL=/api

# LSTM预测服务地址
# 必须与 lstm-prediction-server/server.py 的 app.run(port=5001) 一致。
# 写 5000 会让健康检查一直失败、预测全部走降级。
VITE_LSTM_BASE_URL=http://localhost:5001

# ─────────────────────────────────────────────────────────────
# AI 分析功能的密钥**不在这里**。
# AI 请求全部由后端（3001）代理转发，密钥只进后端进程，不进前端 bundle。
# 请把密钥配到 backend/.env：
#   AI_API_KEY=你的智谱GLM密钥        （https://open.bigmodel.cn/）
#   AI_QWEN_API_KEY=你的通义千问密钥  （https://dashscope.console.aliyun.com/）
# 不填也能跑，只是 AI 面板会走降级分析。
# ─────────────────────────────────────────────────────────────
