# 端口配置
PORT=3001

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_NAME=boat_fire_system
DB_USER=root
DB_PASSWORD=

# AI API配置 —— AI 请求由后端代理转发，密钥只进后端进程，不进前端 bundle。
# AI_PROVIDER: glm（智谱，推荐）| qwen（通义千问）
# 不填也能跑，只是前端 AI 面板会走降级分析。
AI_PROVIDER=glm
AI_API_KEY=
AI_QWEN_API_KEY=

# LSTM 服务地址（演化引擎每秒向它请求一步）
LSTM_SERVICE_URL=http://localhost:5001

# 速率限制（每 IP 每 15 分钟；默认值已覆盖前端正常轮询，压测时再调）
RATE_LIMIT_MAX=5000

# CORS配置
CORS_ORIGIN=http://localhost:5173

# 日志级别
LOG_LEVEL=info
